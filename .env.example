# Copy to .env for local development. Values below are development-only.
APP_NAME=MoneyPilot
MONEY_PILOT_ENVIRONMENT=development
MONEY_PILOT_API_HOST=0.0.0.0
MONEY_PILOT_API_PORT=8000
MONEY_PILOT_LOG_LEVEL=INFO

# API configuration. Generate a new value before any shared deployment.
MONEY_PILOT_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MONEY_PILOT_ACCESS_TOKEN_MINUTES=15
MONEY_PILOT_REFRESH_TOKEN_DAYS=30
MONEY_PILOT_DATABASE_URL=postgresql+psycopg://money_pilot:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@localhost:5432/money_pilot
MONEY_PILOT_REDIS_URL=redis://localhost:6379/0
MONEY_PILOT_ALLOWED_ORIGINS=

# PostgreSQL container
POSTGRES_DB=money_pilot
POSTGRES_USER=money_pilot
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Redis container
REDIS_PORT=6379

# S3-compatible object storage / MinIO
MINIO_ROOT_USER=CHANGE_ME_LOCAL_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MONEY_PILOT_S3_ENDPOINT=http://localhost:9000
MONEY_PILOT_S3_REGION=us-east-1
MONEY_PILOT_S3_BUCKET=money-pilot-dev
MONEY_PILOT_S3_ACCESS_KEY=CHANGE_ME_LOCAL_MINIO_USER
MONEY_PILOT_S3_SECRET_KEY=CHANGE_ME_LOCAL_MINIO_PASSWORD

# Local email capture
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MONEY_PILOT_SMTP_HOST=localhost
MONEY_PILOT_SMTP_PORT=1025
MONEY_PILOT_EMAIL_FROM=noreply@local.money-pilot.invalid

# The API coach currently uses its built-in deterministic provider. Hosted
# provider credentials are not accepted until a provider adapter is implemented.

# Optional error monitoring; leave blank locally.
MONEY_PILOT_SENTRY_DSN=
MONEY_PILOT_DIAGNOSTICS_OPT_IN=false
